#!/usr/bin/env python3
"""
SIVS - Super Intelligence Video Studio (Terminal UI)
Global entry point - uses TUI code from Obsidian (source of truth)
and venv from SIVS-TUI installation.
"""
import sys
import os

# TUI source code location (Obsidian - source of truth)
TUI_SOURCE_DIR = "/Users/mac/Documents/Obsidian Vault/Projects/AI-Video-Studio/tui"

# Virtual environment location (from SIVS-TUI installation)
VENV_DIR = "/Users/mac/SIVS-TUI/.venv"
VENV_PYTHON = os.path.join(VENV_DIR, "bin", "python")

# Re-execute with venv Python if needed
if os.path.exists(VENV_PYTHON) and sys.executable != VENV_PYTHON:
    try:
        os.execv(VENV_PYTHON, [VENV_PYTHON, __file__] + sys.argv[1:])
    except Exception:
        pass

# Add TUI source to path
sys.path.insert(0, TUI_SOURCE_DIR)

# Import and run CLI
from sivs_tui.cli import main

if __name__ == "__main__":
    sys.exit(main())